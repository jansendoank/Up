# ====================================================================
# INFINITYFREE & APACHE SHARED HOSTING CONFIGURATION (.htaccess)
# ====================================================================

# 1. Matikan opsi directory listing demi keamanan (mencegah orang melihat isi folder)
Options -Indexes

# 2. Blokir akses publik ke file tersembunyi (dotfiles) seperti .metadata.json, .password_lock
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# 3. Blokir akses eksplisit ke file kredensial dan konfigurasi sensitif
<FilesMatch "(^\.metadata\.json$|^\.password_lock$|\.env|\.git|\.zip$)">
    Order allow,deny
    Deny from all
</FilesMatch>

# 4. Tetapkan Default Encoding UTF-8
AddDefaultCharset UTF-8

# 5. Header Keamanan Web
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 6. Kompresi Berkas Teks (Jika mod_deflate aktif)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>
